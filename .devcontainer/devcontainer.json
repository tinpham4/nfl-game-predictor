{
  "name": "NFL Game Predictor",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "frontend/index.html"
      ]
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "vscjava.vscode-java-pack"
      ]
    }
  },
  "updateContentCommand": "test -d .venv || python -m venv .venv; .venv/bin/pip install -r requirements-dev.txt; cd backend && ./mvnw -q -DskipTests package",
  "postAttachCommand": {
    "server": "cd backend && ./mvnw spring-boot:run"
  },
  "portsAttributes": {
    "8080": {
      "label": "NFL Game Predictor",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8080
  ]
}
